{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/website",
        "preview",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/dashboard",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "API_URL": "http://localhost:3001",
        "NEXT_DIST_DIR": ".next-preview"
      }
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/api",
        "exec",
        "tsx",
        "src/index.ts"
      ],
      "port": 3001,
      "env": {
        "NODE_ENV": "development",
        "PORT": "3001",
        "DATABASE_URL": "postgresql://gami:gami_dev_password@localhost:5432/gami_community_test",
        "REDIS_URL": "redis://localhost:6379",
        "BETTER_AUTH_SECRET": "local-development-only-auth-secret",
        "ENCRYPTION_MASTER_KEY": "local-development-only-encryption-key",
        "BETTER_AUTH_URL": "http://localhost:3001",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3100",
        "TRUSTED_ORIGINS": "http://localhost:3100",
        "GAMI_DEMO_MODE": "true",
        "GAMI_DEMO_STARTS_PER_HOUR": "50",
        "PLATFORM_BOOTSTRAP_SECRET": "local-development-only-bootstrap-secret"
      }
    },
    {
      "name": "worker-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/worker",
        "exec",
        "tsx",
        "src/index.ts"
      ],
      "port": 3999,
      "env": {
        "NODE_ENV": "development",
        "DATABASE_URL": "postgresql://gami:gami_dev_password@localhost:5432/gami_community_test",
        "REDIS_URL": "redis://localhost:6379",
        "BETTER_AUTH_SECRET": "local-development-only-auth-secret",
        "ENCRYPTION_MASTER_KEY": "local-development-only-encryption-key",
        "BETTER_AUTH_URL": "http://localhost:3001",
        "GAMI_DEMO_MODE": "true"
      }
    }
  ]
}
