---
import LostCharacter from '../components/LostCharacter.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="This page does not exist." og="404" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-6 pb-32 pt-20 text-center">
    <LostCharacter />
    <p class="mt-8 font-mono text-sm text-brand-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-50">This page does not exist</h1>
    <p class="mt-4 text-zinc-400">It may have moved. Your streak is safe, though.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="bg-brand-500 px-4 py-2.5 text-sm font-semibold text-on-accent transition hover:bg-brand-400">Go home</a>
      <a href="/docs/" class="border border-zinc-700 px-4 py-2.5 text-sm font-semibold text-zinc-100 transition hover:border-zinc-500">Open the docs</a>
    </div>
  </section>
</SiteLayout>
