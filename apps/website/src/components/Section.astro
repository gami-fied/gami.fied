---
/** A page section with an optional small label, a heading and an introduction. */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  center?: boolean;
  /** Fade the heading in on scroll. Turn it off when the section starts the page, so its heading is there on first paint. */
  reveal?: boolean;
  /** `h1` when this section's title is the page's main heading. */
  as?: 'h1' | 'h2';
  class?: string;
}

const { id, eyebrow, title, intro, center = false, reveal = true, as = 'h2', class: extra } = Astro.props;
const Heading = as;
---

<section id={id} class:list={['mx-auto max-w-6xl px-6 py-20 sm:py-24', extra]}>
  {
    (eyebrow || title || intro) && (
      <div class:list={['mb-12 max-w-2xl', center && 'mx-auto text-center']} data-reveal={reveal ? '' : undefined}>
        {eyebrow && <p class="font-mono text-xs uppercase tracking-wider text-brand-400">{eyebrow}</p>}
        {title && <Heading class="mt-3 text-balance text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">{title}</Heading>}
        {intro && <p class="mt-4 text-pretty text-base leading-relaxed text-zinc-400">{intro}</p>}
      </div>
    )
  }
  <slot />
</section>
