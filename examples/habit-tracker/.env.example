# Copy this file to .env and fill it in.

# --- The habit tracker -------------------------------------------------------------------
# A project API key with the events:write and users:write scopes. Keep it on the server only.
# Leave it empty at first: you make it in the dashboard after Gami.Fied starts.
GAMI_API_KEY=

# Only for `npm start` (docker compose sets these itself). Where this server reaches Gami.Fied:
GAMI_URL=http://localhost:3000
# Where the browser reaches Gami.Fied, if different from GAMI_URL:
# PUBLIC_GAMI_URL=https://gami.example.com
PORT=4000

# --- Gami.Fied, for docker compose -------------------------------------------------------
# Long random values. Make each one with: openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
# Keep a copy of this one somewhere safe: backups cannot be restored without it.
ENCRYPTION_MASTER_KEY=
# Lets you claim the first platform admin account.
PLATFORM_BOOTSTRAP_SECRET=

# --- Only when putting it online ---------------------------------------------------------
# DASHBOARD_URL=https://habits-admin.example.com
# TRUST_PROXY=true
