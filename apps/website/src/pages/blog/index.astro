---
import { Rss } from '@lucide/astro';
import Section from '../../components/Section.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatDate, publishedPosts } from '../../lib/blog';

const posts = await publishedPosts();
---

<SiteLayout title="Blog" description="Releases, guides on gamification design, and what we are building next." og="blog">
  <Section eyebrow="Blog" title="News and notes" intro="Releases, guides on designing rewards that work, and what is next." class="pt-24 pb-24">
    <a href="/rss.xml" class="mb-10 inline-flex items-center gap-2 text-xs text-zinc-500 hover:text-zinc-200">
      <Rss size={14} aria-hidden="true" /> Subscribe with RSS
    </a>
    <ol class="divide-y divide-zinc-800 border-y border-zinc-800">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group grid gap-2 py-8 md:grid-cols-[10rem_1fr]">
              <time datetime={post.data.date.toISOString()} class="text-sm text-zinc-500">
                {formatDate(post.data.date)}
              </time>
              <div>
                <h2 class="text-xl font-semibold text-zinc-100 transition-colors group-hover:text-brand-300">{post.data.title}</h2>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-400">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
    {posts.length === 0 && <p class="text-zinc-400">Nothing here yet.</p>}
  </Section>
</SiteLayout>
