# ==============================================================================
# Gami.Fied local development configuration
# Copy to .env. These values match docker-compose.dev.yml and are NOT secrets.
# For deployments, start from .env.production.example instead.
# ==============================================================================

NODE_ENV=development

# Infrastructure from `pnpm infra:up`
DATABASE_URL=postgresql://gami:gami_dev_password@localhost:5432/gami_community
DATABASE_URL_TEST=postgresql://gami:gami_dev_password@localhost:5432/gami_community_test
REDIS_URL=redis://localhost:6379

# Apps
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development-only secrets
BETTER_AUTH_SECRET=local-development-only-auth-secret
ENCRYPTION_MASTER_KEY=local-development-only-encryption-key
PLATFORM_BOOTSTRAP_SECRET=local-development-only-bootstrap-secret

# Permit webhooks to reach services on this machine
ALLOW_LOCAL_WEBHOOKS=true
