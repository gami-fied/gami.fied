---
import { ArrowRight } from '@lucide/astro';
import type { FeatureArea } from '../lib/features';
import FeatureIcon from './FeatureIcon.astro';

interface Props {
  feature: FeatureArea;
}

const { feature } = Astro.props;
---

<a
  href={`/features/${feature.slug}/`}
  class="group flex flex-col border border-zinc-800 bg-zinc-900/30 p-6 transition duration-150 hover:border-zinc-700 hover:bg-zinc-900/70"
>
  <span class="flex h-10 w-10 items-center justify-center border border-zinc-800 bg-zinc-950 text-brand-400" transition:name={`feature-icon-${feature.slug}`}>
    <FeatureIcon slug={feature.slug} />
  </span>
  <h3 class="mt-5 text-base font-semibold text-zinc-100" transition:name={`feature-title-${feature.slug}`}>{feature.name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{feature.tagline}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-300">
    Explore {feature.name.toLowerCase()}
    <ArrowRight size={14} class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true" />
  </span>
</a>
