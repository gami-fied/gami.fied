---
/**
 * The same first step in three ways. Tabs are plain buttons with a few lines of script, so the
 * code is in the page as HTML and readable even before JavaScript runs.
 */
import { Code } from 'astro:components';
import { codeTheme } from '../../lib/code-theme';

interface Tab {
  id: string;
  label: string;
  lang: 'ts' | 'bash' | 'tsx';
  code: string;
}

const tabs: Tab[] = [
  {
    id: 'sdk',
    label: 'Node.js',
    lang: 'ts',
    code: `import { Gami } from '@gami.fied/sdk';

const gami = new Gami({ baseUrl: process.env.GAMI_API_URL, apiKey: process.env.GAMI_API_KEY });

// Rules, streaks and achievements run in the background.
await gami.events.track({
  userId: 'user_123',
  type: 'lesson_completed',
  properties: { course: 'spanish-101' },
});`,
  },
  {
    id: 'curl',
    label: 'cURL',
    lang: 'bash',
    code: `curl -X POST https://gami.example.com/v1/events \\
  -H "x-api-key: $GAMI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{ "event": "lesson_completed", "user_id": "user_123" }'`,
  },
  {
    id: 'react',
    label: 'React',
    lang: 'tsx',
    code: `import { GamiProvider, LevelProgress, StreakCalendar, ToastHost } from '@gami.fied/react';
import '@gami.fied/react/styles.css';

export function Rewards({ token }: { token: string }) {
  return (
    <GamiProvider endUserToken={token} baseUrl="https://gami.example.com">
      <LevelProgress />
      <StreakCalendar />
      <ToastHost position="bottom-right" />
    </GamiProvider>
  );
}`,
  },
];
---

<div class="min-w-0 border border-zinc-800 bg-zinc-950" data-code-tabs>
  <div class="flex border-b border-zinc-800" role="tablist" aria-label="Code samples">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="relative px-4 py-3 text-xs font-semibold text-zinc-500 transition-colors hover:text-zinc-200 aria-selected:text-zinc-100 aria-selected:after:absolute aria-selected:after:inset-x-0 aria-selected:after:-bottom-px aria-selected:after:h-0.5 aria-selected:after:bg-brand-500"
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={index !== 0} class="overflow-x-auto p-5 text-[13px] leading-relaxed [&_pre]:!bg-transparent">
        <Code code={tab.code} lang={tab.lang} theme={codeTheme} />
      </div>
    ))
  }
</div>

<script>
  // Works for every tab set on the page, and again after page transitions.
  const setup = () => {
    document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const select = (next: HTMLButtonElement) => {
        for (const tab of tabs) {
          const on = tab === next;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
          if (panel) panel.hidden = !on;
        }
        next.focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (event) => {
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          event.preventDefault();
          select(tabs[(index + step + tabs.length) % tabs.length]!);
        });
      });
    });
  };
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
