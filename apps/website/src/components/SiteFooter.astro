---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {SITE.name}. The server is AGPL-3.0, and the SDK is MIT.
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a class="transition-colors hover:text-zinc-200" href="/docs/">Docs</a></li>
      <li><a class="transition-colors hover:text-zinc-200" href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="transition-colors hover:text-zinc-200" href={`${SITE.github}/blob/master/CHANGELOG.md`} target="_blank" rel="noopener">Changelog</a></li>
    </ul>
  </div>
</footer>
