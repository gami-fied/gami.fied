# ==============================================================================
# Gami.Fied Community Edition — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------

# PostgreSQL password used by docker-compose.yml (required by Compose)
POSTGRES_PASSWORD=your_secure_password_here

# Redis password. docker-compose.yml refuses to start without it.
REDIS_PASSWORD=your_secure_redis_password_here

# PostgreSQL Database Connection String
# Example: postgresql://username:password@localhost:5432/gami_prod
DATABASE_URL=postgresql://gami:your_secure_password_here@localhost:5432/gami_community

# Redis Cache & Queue Connection URL or Host
# Example: redis://localhost:6379 or redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Better Auth Secret (min 16 characters string for session HMAC signing & JWT verification)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-32-byte-secret-key-goes-here

# Better Auth Application URL (Base URL where Gami.Fied API service runs)
BETTER_AUTH_URL=http://localhost:3001

# Public Dashboard Application URL (Base URL where Next.js UI runs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RECOMMENDED PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------

# Symmetric Master Key for AES-256-GCM Credential & Webhook Secret Encryption
# (Must NOT use default development fallback in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your-32-byte-hex-encryption-master-key-here
WEBHOOK_MASTER_KEY=your-32-byte-hex-encryption-master-key-here

# During a key rotation, set this to the old key so existing secrets still decrypt
# ENCRYPTION_MASTER_KEY_PREVIOUS=

# SMTP Outbound Email Notification Configuration
# Required if transaction email notifications are enabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@gami.fied.cc
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=notifications@gami.fied.cc
SMTP_FROM_NAME="Gami.Fied Platform"
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 3. OPTIONAL & SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------

# Node Environment ('production' | 'development' | 'test')
NODE_ENV=production

# Server Network Host & Ports
PORT=3001
HOST=0.0.0.0
DASHBOARD_PORT=3000

# Image version to run. Pin this in production, for example GAMI_VERSION=1.2.3
GAMI_VERSION=latest

# Bootstrap Secret for claiming first-run Platform Admin access
PLATFORM_BOOTSTRAP_SECRET=your-secure-bootstrap-secret-token

# Set to true only behind a reverse proxy that overwrites X-Forwarded-* headers
TRUST_PROXY=false

# Requests per minute allowed from one IP address
RATE_LIMIT_IP_MAX=600

# Outbox Poller Interval (Milliseconds)
OUTBOX_POLL_INTERVAL_MS=1000
