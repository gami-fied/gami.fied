{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/website",
        "preview",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@gami/dashboard",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "API_URL": "http://localhost:3001"
      }
    }
  ]
}
