{
  "name": "gami-fied",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gami-fied/gami.fied.git"
  },
  "homepage": "https://github.com/gami-fied/gami.fied#readme",
  "bugs": {
    "url": "https://github.com/gami-fied/gami.fied/issues"
  },
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test --concurrency=1",
    "format": "prettier --write \".\"",
    "format:check": "prettier --check \".\"",
    "typecheck": "turbo typecheck",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "infra:status": "docker compose -f docker-compose.dev.yml ps",
    "db:generate": "pnpm --filter @gami/database db:generate",
    "db:migrate": "pnpm --filter @gami/database db:migrate",
    "db:migrate:dev": "pnpm --filter @gami/database db:migrate:dev",
    "db:seed": "pnpm --filter @gami/database db:seed",
    "admin:promote": "pnpm --filter @gami/database admin:promote",
    "backup:create": "tsx scripts/backup-cli.ts create",
    "backup:list": "tsx scripts/backup-cli.ts list",
    "backup:verify": "tsx scripts/backup-cli.ts verify",
    "backup:restore": "tsx scripts/backup-cli.ts restore",
    "org:export": "tsx scripts/org-data-cli.ts export",
    "org:import": "tsx scripts/org-data-cli.ts import"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
