{
  "name": "gami-community-root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \".\"",
    "format:check": "prettier --check \".\"",
    "typecheck": "turbo typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "db:generate": "pnpm --filter @gami/database db:generate",
    "db:migrate": "pnpm --filter @gami/database db:migrate",
    "db:seed": "pnpm --filter @gami/database db:seed"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
