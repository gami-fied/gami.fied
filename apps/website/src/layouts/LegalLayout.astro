---
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  description: string;
  og: string;
  updated: string;
}

const { title, description, og, updated } = Astro.props;
const links = [
  { href: '/legal/privacy/', label: 'Privacy' },
  { href: '/legal/terms/', label: 'Terms' },
  { href: '/legal/licences/', label: 'Licences' },
];
---

<SiteLayout title={title} description={description} og={og}>
  <div class="mx-auto grid max-w-5xl gap-10 px-6 pb-24 pt-16 sm:pt-20 md:grid-cols-[10rem_1fr]">
    <nav aria-label="Legal" class="text-sm">
      <ul class="flex gap-4 md:flex-col md:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}
                class="text-zinc-500 transition-colors hover:text-zinc-200 aria-[current=page]:font-semibold aria-[current=page]:text-zinc-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article class="prose prose-site max-w-none prose-headings:tracking-tight prose-h2:mt-10 prose-a:underline-offset-4">
      <h1>{title}</h1>
      <p class="text-sm !text-zinc-500">Last updated {updated}</p>
      <slot />
    </article>
  </div>
</SiteLayout>
