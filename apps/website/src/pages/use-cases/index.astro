---
import { ArrowRight } from '@lucide/astro';
import Section from '../../components/Section.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { USE_CASES } from '../../lib/use-cases';
---

<SiteLayout
  title="Use cases"
  description="How Gami.Fied fits learning apps, fitness apps, communities and SaaS onboarding: the events to send, the rules to start from, and what to watch out for."
  og="use-cases"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Use cases', href: '/use-cases/' }]}
>
  <Section
    reveal={false}
    as="h1"
    eyebrow="Use cases"
    title="What are you building?"
    intro="Each page shows the events to send, a rule to start from, the mechanics that fit, and where gamification can go wrong. They match the project templates in the dashboard."
    class="pb-24 pt-24"
  >
    <ul class="grid gap-4 md:grid-cols-2" data-reveal-group>
      {
        USE_CASES.map((item) => (
          <li>
            <a href={`/use-cases/${item.slug}/`} class="group flex h-full flex-col border border-zinc-800 bg-zinc-900/30 p-7 transition-colors hover:border-zinc-600">
              <h2 class="text-xl font-semibold text-zinc-50">{item.name}</h2>
              <p class="mt-2 font-medium text-zinc-300">{item.tagline}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">{item.summary}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-400">
                See how it fits <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</SiteLayout>
