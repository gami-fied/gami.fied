---
import { FOOTER, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-bold text-zinc-100">
        <img src="/favicon.svg" alt="" width="24" height="24" class="border border-zinc-800" />
        {SITE.name}
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-zinc-500">{SITE.tagline}.</p>
    </div>
    {
      FOOTER.map((column) => (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">{column.title}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-zinc-500 transition-colors hover:text-zinc-200"
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-zinc-900">
    <p class="mx-auto max-w-6xl px-6 py-6 text-xs text-zinc-600">
      © {year} {SITE.name}. The server is AGPL-3.0 and the SDK is MIT. See <a class="underline hover:text-zinc-400" href="/legal/licences/">licences</a>.
    </p>
  </div>
</footer>
