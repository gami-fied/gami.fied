---
import { NAV, SITE } from '../lib/site';
---

<header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/85 backdrop-blur" transition:persist>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:gap-6 sm:px-6" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-bold tracking-tight text-zinc-100" aria-label={`${SITE.name} home`}>
      <img src="/favicon.svg" alt="" width="28" height="28" class="border border-zinc-800" />
      <span>{SITE.name}</span>
    </a>
    <ul class="flex items-center text-sm sm:gap-1">
      {
        NAV.map((link) => (
          <li class={link.wide ? 'hidden sm:block' : undefined}>
            <a
              href={link.href}
              class="px-2.5 py-2 sm:px-3 text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
              {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
