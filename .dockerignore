# Patterns start with **/ because a plain name only matches at the repository root.

# Dependencies and build outputs
**/node_modules
**/.pnpm-store
**/dist
**/.next
**/out
**/build
**/.turbo
**/coverage
**/*.tsbuildinfo

# Environment files and local data, which must never reach an image
**/.env
**/.env.local
**/.env.*.local
**/storage
**/*.pem
**/*.key

# Version control and tooling
.git
.github
.claude
.gitignore
.editorconfig
**/*.md
**/Dockerfile
docker-compose*.yml
Caddyfile.example

# Docs, apart from the API spec the image serves
docs/*
!docs/openapi.json

# Logs and temp files
**/*.log
.tmp
scratch
