{
  "name": "@gami/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@gami/config": "workspace:*",
    "@gami/progression": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@gami/challenges": "workspace:*",
    "@gami/rules": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
