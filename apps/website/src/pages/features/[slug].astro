---
import { Image } from 'astro:assets';
import { ArrowLeft, ArrowRight, BookOpen } from '@lucide/astro';
import Button from '../../components/Button.astro';
import FeatureIcon from '../../components/FeatureIcon.astro';
import FeatureVisual from '../../components/FeatureVisual.astro';
import RichText from '../../components/RichText.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { FEATURES, type FeatureArea } from '../../lib/features';
import { screenshotFor } from '../../lib/screenshots';

export function getStaticPaths() {
  return FEATURES.map((feature, index) => ({
    params: { slug: feature.slug },
    props: { feature, next: FEATURES[(index + 1) % FEATURES.length]! },
  }));
}

interface Props {
  feature: FeatureArea;
  next: FeatureArea;
}

const { feature, next } = Astro.props;
const screenshot = screenshotFor(feature.slug);
---

<SiteLayout title={feature.name} description={`${feature.tagline} ${feature.summary}`} og={`features/${feature.slug}`}>
  <section class="mx-auto max-w-6xl px-6 pb-16 pt-16 sm:pt-20">
    <a href="/features/" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 transition-colors hover:text-zinc-200">
      <ArrowLeft size={14} aria-hidden="true" /> All features
    </a>
    <div class="mt-8 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <span class="flex h-12 w-12 items-center justify-center border border-zinc-800 bg-zinc-950 text-brand-400" transition:name={`feature-icon-${feature.slug}`}>
          <FeatureIcon slug={feature.slug} size={24} />
        </span>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl" transition:name={`feature-title-${feature.slug}`}>{feature.name}</h1>
        <p class="mt-3 text-lg font-medium text-zinc-300">{feature.tagline}</p>
        <p class="mt-4 max-w-xl text-pretty leading-relaxed text-zinc-400">{feature.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/docs/">Get started</Button>
          {feature.guides[0] && (
            <Button href={feature.guides[0].href} variant="secondary" external>
              <BookOpen size={16} aria-hidden="true" /> Read the guide
            </Button>
          )}
        </div>
      </div>
      <FeatureVisual slug={feature.slug} />
    </div>
  </section>

  {
    screenshot && (
      <section class="mx-auto max-w-6xl px-6 pb-16" aria-labelledby="in-the-dashboard">
        <h2 id="in-the-dashboard" class="font-mono text-xs uppercase tracking-wider text-brand-400">
          In the dashboard
        </h2>
        <figure class="mt-4">
          <div class="overflow-hidden border border-zinc-800 bg-zinc-950 shadow-[0_24px_80px_-24px_rgba(0,0,0,0.8)]">
            <div class="flex items-center gap-1.5 border-b border-zinc-800 px-3 py-2" aria-hidden="true">
              <span class="h-2 w-2 bg-zinc-700" />
              <span class="h-2 w-2 bg-zinc-700" />
              <span class="h-2 w-2 bg-zinc-700" />
            </div>
            <Image
              src={screenshot.image}
              alt={`The ${screenshot.page} page of the Gami.Fied dashboard, with demo data.`}
              widths={[720, 1080, 1440]}
              sizes="(min-width: 1152px) 1104px, 100vw"
              class="block h-auto w-full"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 text-xs text-zinc-500">
            The {screenshot.page} page, from the live demo.
          </figcaption>
        </figure>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 pb-20" aria-labelledby="capabilities">
    <h2 id="capabilities" class="sr-only">What it does</h2>
    <ul class="grid gap-px border border-zinc-800 bg-zinc-800 sm:grid-cols-2 lg:grid-cols-3">
      {
        feature.capabilities.map((capability) => (
          <li class="bg-zinc-950 p-6">
            <h3 class="font-semibold text-zinc-100">{capability.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">
              <RichText text={capability.text} />
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-6 border border-zinc-800 bg-zinc-900/30 p-6 md:grid-cols-2 md:p-8">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400">Guides</h2>
        <ul class="mt-4 space-y-2">
          {
            feature.guides.map((guide) => (
              <li>
                <a href={guide.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-brand-300 hover:underline">
                  <BookOpen size={14} aria-hidden="true" /> {guide.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a href={`/features/${next.slug}/`} class="group flex flex-col justify-center border border-zinc-800 bg-zinc-950 p-5 transition-colors hover:border-zinc-700">
        <span class="text-xs text-zinc-500">Next</span>
        <span class="mt-1 inline-flex items-center gap-2 text-lg font-semibold text-zinc-100">
          {next.name}
          <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </span>
        <span class="mt-1 text-sm text-zinc-400">{next.tagline}</span>
      </a>
    </div>
  </section>
</SiteLayout>
