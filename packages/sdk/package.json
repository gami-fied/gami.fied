{
  "name": "@gami.fied/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript client for Gami.Fied, the self-hosted gamification engine.",
  "keywords": [
    "gamification",
    "xp",
    "achievements",
    "leaderboard",
    "badges",
    "levels",
    "challenges",
    "sdk"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gami-fied/gami.fied.git"
  },
  "homepage": "https://github.com/gami-fied/gami.fied#readme",
  "bugs": {
    "url": "https://github.com/gami-fied/gami.fied/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
