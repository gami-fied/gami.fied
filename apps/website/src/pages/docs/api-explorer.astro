---
/**
 * The whole API on one page, with a "try it" panel. Requests go to the demo instance when one is
 * configured, with its public demo key filled in, and otherwise to whatever server the reader enters.
 */
import { ScalarComponent } from '@scalar/astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../lib/site';
---

<SiteLayout
  title="API explorer"
  description="Every Gami.Fied API route, with request and response examples, and a panel to send requests to the demo instance."
  og="docs"
  footer={false}
>
  {
    !SITE.demoApiUrl && (
      <p class="border-b border-zinc-800 bg-zinc-900/60 px-6 py-2.5 text-center text-xs text-zinc-400">
        The public demo instance is not open yet, so add your own server and API key to send requests.
      </p>
    )
  }
  <div class="scalar-frame">
    <ScalarComponent
      renderMode="client"
      configuration={{
        url: '/docs/openapi.json',
        cdn: '/docs/api-explorer/scalar.js',
        theme: 'none',
        forceDarkModeState: 'dark',
        hideDarkModeToggle: true,
        withDefaultFonts: false,
        telemetry: false,
        showDeveloperTools: 'never',
        agent: { disabled: true },
        persistAuth: false,
        authentication: {
          preferredSecurityScheme: 'apiKey',
          ...(SITE.demoApiKey ? { securitySchemes: { apiKey: { name: 'x-api-key', in: 'header', value: SITE.demoApiKey } } } : {}),
        },
      }}
    />
  </div>
</SiteLayout>

<style is:global>
  /* Scalar's colours, mapped to the site's. */
  .scalar-frame .dark-mode,
  .scalar-frame .light-mode {
    --scalar-font: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    --scalar-font-code: 'Space Mono', ui-monospace, monospace;
    --scalar-background-1: var(--color-zinc-950);
    --scalar-background-2: var(--color-zinc-900);
    --scalar-background-3: var(--color-zinc-800);
    --scalar-border-color: var(--color-zinc-800);
    --scalar-color-1: var(--color-zinc-100);
    --scalar-color-2: var(--color-zinc-400);
    --scalar-color-3: var(--color-zinc-500);
    --scalar-color-accent: var(--color-brand-400);
    --scalar-background-accent: color-mix(in oklab, var(--color-brand-500) 15%, transparent);
    --scalar-button-1: var(--color-brand-500);
    --scalar-button-1-color: var(--color-on-accent);
    --scalar-button-1-hover: var(--color-brand-400);
    --scalar-radius: 0;
    --scalar-radius-lg: 0;
    --scalar-radius-xl: 0;
    /* Clears the sticky site header. */
    --scalar-custom-header-height: 4rem;
  }
</style>
