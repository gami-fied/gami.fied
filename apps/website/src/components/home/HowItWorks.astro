---
/**
 * The three steps, each with the code that does it and what the player sees. This stacked layout is
 * what phones and reduced motion get; WEB-38 turns it into a pinned scroll story on wide screens.
 */
import { Code } from 'astro:components';
import { codeTheme } from '../../lib/code-theme';

const steps = [
  {
    title: 'Send an event',
    text: 'Your server, or the SDK in your app, tells Gami.Fied what someone did. A retry with the same idempotency key never counts twice.',
    lang: 'ts' as const,
    highlight: 3,
    code: `await gami.events.track({
  userId: 'user_123',
  type: 'lesson_completed',
});`,
    result: { label: 'Event received', detail: 'lesson_completed · user_123', tone: 'info' },
  },
  {
    title: 'A rule matches',
    text: 'Rules you set up in the dashboard decide what it is worth. Change them any time, test them on past events, and roll back if needed.',
    lang: 'json' as const,
    highlight: 3,
    code: `{
  "trigger": "lesson_completed",
  "actions": [{ "type": "award_xp", "params": { "amount": 50 } }]
}`,
    result: { label: 'Rule matched', detail: 'Lesson reward · +50 XP', tone: 'brand' },
  },
  {
    title: 'The player is rewarded',
    text: 'XP lands in their ledger, their streak grows, badges unlock and the leaderboard moves, live in your app through the SDK or React components.',
    lang: 'tsx' as const,
    highlight: 1,
    code: `<LevelProgress />
<StreakCalendar />
<ToastHost />`,
    result: { label: 'Level 7 reached', detail: '12-day streak · Seven-day streak badge', tone: 'success' },
  },
];

const tones = {
  info: 'border-info-800/70 bg-info-950/40 text-info-200',
  brand: 'border-brand-800/70 bg-brand-950/40 text-brand-200',
  success: 'border-success-800/70 bg-success-950/40 text-success-200',
} as const;
---

<div class="how-it-works" data-how-it-works>
  <!-- Revealed like the rest of the site only where the scroll story does not run. -->
  <ol class="how-steps space-y-6" data-reveal-group data-reveal-media="(max-width: 1023px), (prefers-reduced-motion: reduce)">
    {
      steps.map((step, index) => (
        <li class="how-step grid gap-6 border border-zinc-800 bg-zinc-900/30 p-6 md:grid-cols-[1fr_1.1fr] md:p-8" data-step={index + 1}>
          <div>
            <span class="font-mono text-xs text-brand-400">Step {index + 1}</span>
            <h3 class="mt-2 text-xl font-semibold text-zinc-50">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{step.text}</p>
            <div class:list={['how-result mt-6 inline-flex flex-col border px-4 py-3 text-sm', tones[step.result.tone as keyof typeof tones]]}>
              <span class="font-semibold">{step.result.label}</span>
              <span class="mt-0.5 text-xs opacity-80">{step.result.detail}</span>
            </div>
          </div>
          <div class="how-code overflow-x-auto border border-zinc-800 bg-zinc-950 p-5 text-[13px] leading-relaxed [&_pre]:!bg-transparent" data-highlight={step.highlight}>
            <Code code={step.code} lang={step.lang} theme={codeTheme} />
          </div>
        </li>
      ))
    }
  </ol>

  <!-- The phone in the scroll story (WEB-38), shown only on wide screens with motion. It repeats the
       results above, so it is hidden from screen readers. -->
  <div class="how-phone" aria-hidden="true" data-story-phone>
    <div class="how-phone-frame">
      <div class="how-phone-bar"><span>9:41</span><span>Lingo Leap</span></div>
      <div class="space-y-3 p-4">
        <div class="how-phone-card" data-phone="event">
          <span class="font-mono text-[11px] text-info-300">lesson_completed</span>
          <span class="text-[11px] text-zinc-500">sent by your server</span>
        </div>
        <div class="how-phone-card" data-phone="rule">
          <span class="text-xs font-semibold text-zinc-100">Lesson reward</span>
          <span class="text-[11px] text-brand-300">Rule matched · +50 XP</span>
        </div>
        <div class="how-phone-level" data-phone="xp">
          <div class="flex justify-between text-[11px] text-zinc-400"><span>Level 7</span><span>1,250 XP</span></div>
          <div class="mt-1.5 h-1.5 bg-zinc-800"><div class="h-full origin-left bg-brand-500" data-phone="xp-fill"></div></div>
        </div>
        <div class="how-phone-toast" data-phone="toast">
          <span class="text-base" aria-hidden="true">★</span>
          <span>
            <span class="block text-xs font-semibold text-success-100">Seven-day streak</span>
            <span class="block text-[11px] text-success-200/80">Badge unlocked · 12 days</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../motion/scenes/how-it-works';
</script>
