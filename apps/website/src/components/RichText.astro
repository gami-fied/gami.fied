---
/** Short copy with `inline code` marked by backticks, as written in lib/features.ts. */
interface Props {
  text: string;
}

const parts = Astro.props.text.split('`');
---

{parts.map((part, index) => (index % 2 === 1 ? <code class="bg-zinc-800/80 px-1 py-0.5 text-[0.85em] text-zinc-200">{part}</code> : part))}
