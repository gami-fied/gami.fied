---
/**
 * A small, still picture of each feature area, drawn in HTML so it matches the product. WEB-40
 * animates these; this still version is what people with reduced motion see.
 */
import type { FeatureArea } from '../lib/features';

interface Props {
  slug: FeatureArea['slug'];
}

const { slug } = Astro.props;

const week = [
  { day: 'M', state: 'done' },
  { day: 'T', state: 'done' },
  { day: 'W', state: 'frozen' },
  { day: 'T', state: 'done' },
  { day: 'F', state: 'done' },
  { day: 'S', state: 'today' },
  { day: 'S', state: 'empty' },
];
const board = [
  { rank: 1, name: 'Aiko', xp: 4820, zone: 'up' },
  { rank: 2, name: 'Maya', xp: 4410, zone: 'up' },
  { rank: 3, name: 'You', xp: 3975, zone: 'me' },
  { rank: 4, name: 'Leo', xp: 3120, zone: '' },
  { rank: 5, name: 'Sam', xp: 2240, zone: 'down' },
];
const feed = [
  { who: 'Maya', what: 'earned', detail: 'Seven-day streak' },
  { who: 'Leo', what: 'got kudos from', detail: 'you' },
  { who: 'Sam', what: 'moved up to', detail: 'Gold' },
];
const switches = [
  { name: 'Reward store', on: true, note: 'Needs Currencies & wallets' },
  { name: 'Leagues', on: true, note: 'Needs Leaderboards' },
  { name: 'Connectors', on: false, note: 'Off for this organization' },
];
---

<div class="relative border border-zinc-800 bg-zinc-900/40 p-6" data-feature-visual={slug} aria-hidden="true">
  {
    slug === 'progression' && (
      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between text-xs text-zinc-400">
            <span>Daily streak</span>
            <span class="font-mono text-brand-300">12 days</span>
          </div>
          <div class="mt-3 grid grid-cols-7 gap-2">
            {week.map((cell) => (
              <div class="text-center">
                <div
                  class:list={[
                    'aspect-square border',
                    cell.state === 'done' && 'border-brand-500/60 bg-brand-500/80',
                    cell.state === 'frozen' && 'border-info-500/60 bg-info-500/40',
                    cell.state === 'today' && 'border-brand-400 bg-brand-500/20',
                    cell.state === 'empty' && 'border-zinc-800 bg-zinc-900',
                  ]}
                />
                <span class="mt-1 block text-[10px] text-zinc-500">{cell.day}</span>
              </div>
            ))}
          </div>
          <p class="mt-2 text-[11px] text-info-300">Wednesday was saved by a freeze.</p>
        </div>
        <div>
          <div class="flex items-center justify-between text-xs">
            <span class="font-semibold text-zinc-200">Level 7 · Explorer</span>
            <span class="font-mono text-zinc-400">1,440 / 2,000 XP</span>
          </div>
          <div class="mt-2 h-2 bg-zinc-800">
            <div class="h-full w-[72%] bg-brand-500" />
          </div>
        </div>
      </div>
    )
  }
  {
    slug === 'economy' && (
      <div class="space-y-4">
        <div class="flex items-center justify-between border border-zinc-800 bg-zinc-950/60 p-4">
          <div>
            <p class="text-xs text-zinc-500">Wallet</p>
            <p class="mt-1 text-2xl font-bold text-zinc-50">1,240 <span class="text-sm font-medium text-zinc-400">coins</span></p>
          </div>
          <p class="text-right text-[11px] text-warning-300">80 expire<br />in 3 days</p>
        </div>
        {[
          { name: 'Free coffee', cost: 500, note: 'Unique code' },
          { name: 'Gift card', cost: 2000, note: '2 left' },
        ].map((item) => (
          <div class="flex items-center justify-between border border-zinc-800 px-4 py-3 text-sm">
            <div>
              <p class="font-medium text-zinc-200">{item.name}</p>
              <p class="text-[11px] text-zinc-500">{item.note}</p>
            </div>
            <span class:list={['font-mono text-xs', item.cost <= 1240 ? 'text-brand-300' : 'text-zinc-500']}>{item.cost.toLocaleString('en-US')}</span>
          </div>
        ))}
      </div>
    )
  }
  {
    slug === 'competition' && (
      <div>
        <div class="mb-3 flex items-center justify-between text-xs text-zinc-400">
          <span>Silver league · group 4</span>
          <span>Ends in 2 days</span>
        </div>
        <ol class="space-y-1.5">
          {board.map((row) => (
            <li
              class:list={[
                'flex items-center gap-3 border px-3 py-2 text-sm',
                row.zone === 'me' ? 'border-brand-500/60 bg-brand-500/10' : 'border-zinc-800',
              ]}
            >
              <span class="w-4 font-mono text-xs text-zinc-500">{row.rank}</span>
              <span class="flex-1 text-zinc-200">{row.name}</span>
              <span class="font-mono text-xs text-zinc-400">{row.xp.toLocaleString('en-US')}</span>
              <span class:list={['w-4 text-xs', row.zone === 'up' && 'text-success-400', row.zone === 'down' && 'text-danger-400']}>
                {row.zone === 'up' ? '↑' : row.zone === 'down' ? '↓' : ''}
              </span>
            </li>
          ))}
        </ol>
      </div>
    )
  }
  {
    slug === 'community' && (
      <div class="space-y-4">
        <ul class="space-y-2">
          {feed.map((item) => (
            <li class="flex items-center gap-3 border border-zinc-800 px-3 py-2.5 text-sm">
              <span class="flex h-7 w-7 items-center justify-center bg-zinc-800 text-xs font-semibold text-zinc-300">{item.who[0]}</span>
              <span class="text-zinc-400">
                <span class="font-medium text-zinc-200">{item.who}</span> {item.what} <span class="text-zinc-200">{item.detail}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="flex items-center justify-between border border-dashed border-zinc-700 px-4 py-3">
          <span class="text-xs text-zinc-500">Your invite code</span>
          <span class="font-mono text-sm tracking-[0.2em] text-brand-300">K7P2QX9M</span>
        </div>
      </div>
    )
  }
  {
    slug === 'integrations' && (
      <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-xs">
        <ul class="space-y-2">
          {['Your app', 'Segment', 'Stripe', 'GitHub'].map((name) => (
            <li class="border border-zinc-800 px-3 py-2 text-zinc-300">{name}</li>
          ))}
        </ul>
        <div class="flex h-full flex-col items-center justify-center gap-2">
          <span class="text-zinc-600">→</span>
          <span class="border border-brand-500/60 bg-brand-500/10 px-3 py-6 font-semibold text-brand-200 [writing-mode:vertical-rl]">Gami.Fied</span>
          <span class="text-zinc-600">→</span>
        </div>
        <ul class="space-y-2">
          {['Webhooks', 'Slack and Teams', 'Push', 'React'].map((name) => (
            <li class="border border-zinc-800 px-3 py-2 text-zinc-300">{name}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    slug === 'administration' && (
      <ul class="space-y-2">
        {switches.map((item) => (
          <li class="flex items-center justify-between border border-zinc-800 px-4 py-3">
            <div>
              <p class="text-sm font-medium text-zinc-200">{item.name}</p>
              <p class="text-[11px] text-zinc-500">{item.note}</p>
            </div>
            <span class:list={['flex h-5 w-9 items-center border p-0.5', item.on ? 'justify-end border-success-700 bg-success-900/60' : 'justify-start border-zinc-700 bg-zinc-800']}>
              <span class:list={['h-3.5 w-3.5', item.on ? 'bg-success-400' : 'bg-zinc-500']} />
            </span>
          </li>
        ))}
      </ul>
    )
  }
</div>
