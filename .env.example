# System Environment
NODE_ENV=development

# Application Ports (Host Development)
PORT=3000
DASHBOARD_PORT=3001

# PostgreSQL Configuration
POSTGRES_DB=gami_community
POSTGRES_USER=gami
POSTGRES_PASSWORD=gami_dev_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
# Host connection: redis://localhost:6379
# Container connection: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Database Connection URL
# Host connection: postgresql://gami:gami_dev_password@localhost:5432/gami_community
# Container connection: postgresql://gami:gami_dev_password@postgres:5432/gami_community
DATABASE_URL=postgresql://gami:gami_dev_password@localhost:5432/gami_community
