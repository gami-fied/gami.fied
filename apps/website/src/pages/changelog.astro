---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../lib/site';

// One entry: the repository's CHANGELOG.md.
const [changelog] = await getCollection('changelog');
if (!changelog) throw new Error('CHANGELOG.md was not found at the repository root');
const { Content } = await render(changelog);
---

<SiteLayout title="Changelog" description="Every Gami.Fied release, what changed, and how to upgrade." og="changelog">
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-16 sm:pt-20">
    <p class="font-mono text-xs uppercase tracking-wider text-brand-400">Changelog</p>
    <p class="mt-3 text-sm text-zinc-500">
      The same notes as each <a class="text-brand-300 hover:underline" href={`${SITE.github}/releases`} target="_blank" rel="noopener">GitHub release</a>.
    </p>
    <div class="prose prose-site mt-8 max-w-none prose-h1:text-4xl prose-h2:mt-16 prose-h2:border-t prose-h2:border-zinc-800 prose-h2:pt-10 prose-a:underline-offset-4 prose-pre:border prose-pre:border-zinc-800 prose-pre:rounded-none prose-code:before:content-none prose-code:after:content-none prose-table:text-sm">
      <Content />
    </div>
  </article>
</SiteLayout>
