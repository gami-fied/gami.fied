# The website's settings. All are optional; copy to .env to change them locally.

# The site's public address, used for canonical links, the sitemap and social cards.
PUBLIC_SITE_URL=https://gami.fied.cc

# Set to true on previews and forks: adds noindex everywhere and turns analytics off.
PUBLIC_NOINDEX=false

# Cookie-free analytics, so no consent banner is needed. Leave empty for none.
# PUBLIC_ANALYTICS_PROVIDER=plausible   # or umami
# PUBLIC_ANALYTICS_SCRIPT=https://analytics.example.com/js/script.js
# PUBLIC_ANALYTICS_SITE=gami.fied.cc     # Plausible: the domain. Umami: the website ID.

# Where the pricing page's "Join the waitlist" buttons go, such as a form. Without it they link to GitHub.
# PUBLIC_WAITLIST_URL=https://forms.example.com/gami-cloud

# A contact address for the privacy and terms pages. Without it they point to GitHub issues.
# PUBLIC_CONTACT_EMAIL=hello@example.com
